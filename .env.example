# CMMS environment template
# Copy this file to .env for local development and replace all placeholder values.
# Do not commit real secrets.

APP_ENV=development

# Docker Compose service ports.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
LOCAL_FRONTEND_HOST=127.0.0.1
LOCAL_BACKEND_HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_HEALTH_URL=http://127.0.0.1:8000/health
SWAGGER_URL=http://127.0.0.1:8000/docs

# PostgreSQL container configuration.
POSTGRES_DB=cmms_dev
POSTGRES_USER=cmms_user
POSTGRES_PASSWORD=replace-with-local-db-password
TZ=Africa/Cairo

# Local PostgreSQL development database.
# Use DATABASE_URL when running the backend directly on Windows.
DATABASE_URL=postgresql://cmms_user:replace-with-local-db-password@127.0.0.1:5432/cmms_dev

# Use DOCKER_DATABASE_URL when running the backend inside Docker Compose.
DOCKER_DATABASE_URL=postgresql://cmms_user:replace-with-local-db-password@postgres:5432/cmms_dev

# Required in production.
# Also recommended in development so a local admin account can be created automatically.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-strong-admin-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Optional.
ADMIN_EMAIL=admin@example.com
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE=http://127.0.0.1:8000/api
VITE_API_FALLBACK_BASES=
VITE_API_RELATIVE_BASE=/api
VITE_API_TIMEOUT_MS=60000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
CHOKIDAR_USEPOLLING=true
POSTGRES_WAIT_TIMEOUT_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Structured logging.
# LOG_FORMAT=auto uses human-readable logs in development and JSON logs in production.
LOG_LEVEL=INFO
LOG_FORMAT=auto

# API rate limiting.
# Limits are per client IP and use Retry-After when exceeded.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_TOKEN_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_HEAVY_PER_MINUTE=50
RATE_LIMIT_EXPORT_PER_MINUTE=20
RATE_LIMIT_HEAVY_PATHS=/api/dashboard*,/api/reports*,/api/audit-logs*,/api/assets/*/history*,/api/assets/*/timeline*,/api/assets/*/measurements*
RATE_LIMIT_EXPORT_PATHS=*/export*,*/pdf*,*/print*

# HTTP security headers.
# Development uses a relaxed CSP for Swagger, Vite, PDFs, blobs, and uploaded images.
# Production uses a stricter backend CSP and enables HSTS.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_MODE=auto
SECURITY_CSP_REPORT_ONLY=false
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# Optional SMTP settings for inventory low-stock email alerts.
# Docker development uses Mailpit by default when SMTP_HOST is empty.
# Users receive these emails only when the admin grants Inventory / Email Alerts.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=cmms-test@local.test
SMTP_USE_TLS=false

# SQLite fallback remains available for compatibility.
# To use SQLite locally, comment DATABASE_URL above.
